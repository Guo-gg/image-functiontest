MEM_SOURCE_15;

PINDEF
FSR    = I, BIN, (5)
DR     = I, BIN, (6)
BCLKR  = I, BIN, (7)
MCLKR  = I, BIN, (8)
MCLKX  = I, BIN, (9)
BCLKX  = I, BIN, (10)
FSX    = I, BIN, (12)
DX     = O, BIN, (11)
TSX    = O, BIN, (13)

PIN_TO_CHANNEL
1..16=1..16

MAIN_F

//=============================================================
// 功能测试：同步模式、短帧、2.048MHz
// 模拟条件（由测试程序设定）：VIN=0V -> 编码全‘1’ (11111111)
// MCLKR/PDN = 0，BCLKR/CLKSEL = 1 (选2.048MHz)
// 预期：发送通道空闲码为全1；接收通道可被驱动但不做输出比较
//=============================================================

START_INDEX(0) { 初始化及同步建立 }
    // 保持控制信号稳定，打若干周期让器件退出掉电并同步
    RPT, 15
    INC (0 0 0 0 0 0 0 X X)  // MCLKX=0, MCLKR=0, BCLKX=0, BCLKR=0, FSX=0, FSR=0, DR=0

//=============================================================
// 发送功能测试 (短帧)
// 参照 TP3057 手册 Figure 2
//=============================================================
START_INDEX(1) { 发送帧 PCM 检查 }

    // 产生一个 BCLKX 周期宽度的 FSX 脉冲，在 BCLKX 下降沿附近置高
    // BCLK=0, MCLK=1 阶段将 FSX 置 1
    INC (1 0 1 0 0 1 1 X L)   // MCLKX=1, BCLKX=0, FSX=1, 其余低; TSX 预期 L
    INC (1 0 0 0 0 0 1 X L)   // 保持 FSX=1 一个 BCLK 周期
    INC (0 1 1 0 0 1 0 X L)
    INC (0 1 0 0 0 0 0 X L)   // FSX 变 0

    // 随后的 8 个 BCLKX 上升沿将 8 位 PCM 码移出
    // 预期数据为全‘1’ (对应模拟 0V)，即 DX=H 连续 8 位
    // 每个位用 4 个图形周期描述，在 BCLKX=1 且 MCLKX=1 时比较输出

    // bit 7 (MSB)
    INC (0 1 0 0 0 1 0 H L)
    INC (1 1 0 0 0 1 0 X L)
    INC (1 0 0 0 0 0 0 X L)
    INC (0 0 0 0 0 0 0 X L)

    // bit 6
    INC (0 1 0 0 0 1 0 H L)
    INC (1 1 0 0 0 1 0 X L)
    INC (1 0 0 0 0 0 0 X L)
    INC (0 0 0 0 0 0 0 X L)

    // bit 5
    INC (0 1 0 0 0 1 0 H L)
    INC (1 1 0 0 0 1 0 X L)
    INC (1 0 0 0 0 0 0 X L)
    INC (0 0 0 0 0 0 0 X L)

    // bit 4
    INC (0 1 0 0 0 1 0 H L)
    INC (1 1 0 0 0 1 0 X L)
    INC (1 0 0 0 0 0 0 X L)
    INC (0 0 0 0 0 0 0 X L)

    // bit 3
    INC (0 1 0 0 0 1 0 H L)
    INC (1 1 0 0 0 1 0 X L)
    INC (1 0 0 0 0 0 0 X L)
    INC (0 0 0 0 0 0 0 X L)

    // bit 2
    INC (0 1 0 0 0 1 0 H L)
    INC (1 1 0 0 0 1 0 X L)
    INC (1 0 0 0 0 0 0 X L)
    INC (0 0 0 0 0 0 0 X L)

    // bit 1
    INC (0 1 0 0 0 1 0 H L)
    INC (1 1 0 0 0 1 0 X L)
    INC (1 0 0 0 0 0 0 X L)
    INC (0 0 0 0 0 0 0 X L)

    // bit 0 (LSB) – 完成后 DX 应回到高阻，图形用 X 忽略
    INC (0 1 0 0 0 1 0 H L)
    INC (1 1 0 0 0 1 0 X L)
    INC (1 0 0 0 0 0 0 X L)
    INC (0 0 0 0 0 0 0 X L)

    // 发送后空闲，等待下一个帧
    RPT, 3
    INC (0 0 0 0 0 0 0 X X)

    HALT (0 0 0 0 0 0 0 X X)

//=============================================================
// 接收功能测试 (短帧) – 演示如何驱动接收时序
// 无直接数字输出比较，但可验证接收帧同步不会破坏发送部分
// 此处输入 PCM 码为全‘0’，配合后级模拟测试
//=============================================================
START_INDEX(2) { 接收帧时序驱动 }

    // 产生一个 BCLKR 宽度的 FSR 脉冲 (同步模式下 BCLKR 同 BCLKX)
    INC (1 0 1 0 0 1 0 X L)   // FSR=1
    INC (1 0 1 0 0 0 0 X L)   // FSR=1
    INC (0 1 1 0 0 1 0 X L)
    INC (0 1 0 0 0 0 0 X L)

    // 随后 8 个 BCLKR 下降沿锁存 DR 数据
    // 驱动器通过 DR 输入全‘0’码，测试其接收接口能否正确接收
    // 数据变化在 BCLKR 下降沿之前建立
    // bit 7 (MSB)
    INC (0 1 0 0 0 1 0 X L)   // DR=0
    INC (1 1 0 0 0 1 0 X L)
    INC (1 0 0 0 0 0 0 X L)
    INC (0 0 0 0 0 0 0 X L)

    // bit 6
    INC (0 1 0 0 0 1 0 X L)
    INC (1 1 0 0 0 1 0 X L)
    INC (1 0 0 0 0 0 0 X L)
    INC (0 0 0 0 0 0 0 X L)

    // bit 5
    INC (0 1 0 0 0 1 0 X L)
    INC (1 1 0 0 0 1 0 X L)
    INC (1 0 0 0 0 0 0 X L)
    INC (0 0 0 0 0 0 0 X L)

    // bit 4
    INC (0 1 0 0 0 1 0 X L)
    INC (1 1 0 0 0 1 0 X L)
    INC (1 0 0 0 0 0 0 X L)
    INC (0 0 0 0 0 0 0 X L)

    // bit 3
    INC (0 1 0 0 0 1 0 X L)
    INC (1 1 0 0 0 1 0 X L)
    INC (1 0 0 0 0 0 0 X L)
    INC (0 0 0 0 0 0 0 X L)

    // bit 2
    INC (0 1 0 0 0 1 0 X L)
    INC (1 1 0 0 0 1 0 X L)
    INC (1 0 0 0 0 0 0 X L)
    INC (0 0 0 0 0 0 0 X L)

    // bit 1
    INC (0 1 0 0 0 1 0 X L)
    INC (1 1 0 0 0 1 0 X L)
    INC (1 0 0 0 0 0 0 X L)
    INC (0 0 0 0 0 0 0 X L)

    // bit 0 (LSB)
    INC (0 1 0 0 0 1 0 X L)
    INC (1 1 0 0 0 1 0 X L)
    INC (1 0 0 0 0 0 0 X L)
    INC (0 0 0 0 0 0 0 X L)

    RPT, 3
    INC (0 0 0 0 0 0 0 X X)

    HALT (0 0 0 0 0 0 0 X X)

END.
